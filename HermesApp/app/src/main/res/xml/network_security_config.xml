<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Hermes / fnOS are reached over plain HTTP on LAN or a high IPv6 port. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>

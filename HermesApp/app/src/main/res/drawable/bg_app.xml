<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient
                android:angle="270"
                android:endColor="@color/sky"
                android:startColor="@color/cream" />
        </shape>
    </item>

    <item
        android:width="190dp"
        android:height="190dp"
        android:gravity="top|end"
        android:top="-46dp"
        android:right="-42dp">
        <shape android:shape="oval">
            <solid android:color="#33FF8FA8" />
        </shape>
    </item>

    <item
        android:width="230dp"
        android:height="230dp"
        android:gravity="bottom|start"
        android:bottom="-90dp"
        android:left="-80dp">
        <shape android:shape="oval">
            <solid android:color="#40BDF2DC" />
        </shape>
    </item>

    <item
        android:width="64dp"
        android:height="64dp"
        android:gravity="top|start"
        android:top="150dp"
        android:left="-22dp">
        <shape android:shape="oval">
            <solid android:color="#40FFD86B" />
        </shape>
    </item>
</layer-list>

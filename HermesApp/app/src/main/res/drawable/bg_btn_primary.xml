<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="4dp">
        <shape>
            <solid android:color="@color/ink" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item android:bottom="4dp">
        <ripple android:color="#40FFFFFF">
            <item>
                <shape>
                    <gradient
                        android:angle="270"
                        android:endColor="@color/pink_deep"
                        android:startColor="#FFB3C3" />
                    <corners android:radius="24dp" />
                    <stroke
                        android:width="2dp"
                        android:color="@color/ink" />
                </shape>
            </item>
        </ripple>
    </item>
</layer-list>
